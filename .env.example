# ClipForge configuration — copy to .env and edit.
# config.py auto-loads ROOT/.env on import (KEY=VALUE per line).
# Values already in the environment take precedence over this file.

# --- LLM backend -----------------------------------------------------------
# "cli" (default) = local Claude Code CLI (`claude -p`) on your subscription,
#                   no API key / credits needed. Requires `claude` on PATH.
# "api"           = anthropic Python SDK, pay-per-token (needs ANTHROPIC_API_KEY).
CLIPFORGE_LLM=cli

# Only used when CLIPFORGE_LLM=api.
ANTHROPIC_API_KEY=

# Claude model id (both backends).
CLIPFORGE_MODEL=claude-opus-4-8

# --- DaVinci Resolve bridge (WSL2 -> Windows host) -------------------------
# Windows host IP as seen from WSL, the bridge port, and the Windows-visible
# drop folder (a WSL path to a Windows directory).
CLIPFORGE_WIN_HOST=172.20.16.1
CLIPFORGE_RESOLVE_PORT=8765
CLIPFORGE_WIN_SHARE=/mnt/c/Users/Public/ClipForge

# Optional shared secret for the bridge. The bridge binds 0.0.0.0 (WSL can't
# reach a Windows-side localhost-only listener), so anything on the same
# network can otherwise call it unauthenticated. Set the SAME value here and
# in the Windows-side environment running bridge_server.py to require a
# matching X-ClipForge-Token header on every request. Leave blank to keep the
# old (unauthenticated) behaviour. See resolve/README.md.
CLIPFORGE_BRIDGE_TOKEN=
